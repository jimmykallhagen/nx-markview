{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nordix Markdown Viewer",
  "version": "0.1.0",
  "identifier": "com.nordix.markview",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
"windows": [
    {
        "title": "Nordix Markdown Viewer",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "decorations": false
    }
],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/28x128@2.png",
      "icons/256x256.png"
    ]
  }
}
